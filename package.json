{
  "name": "pw-practice-lab",
  "private": true,
  "version": "1.1.1",
  "description": "Static practice site for Playwright test automation",
  "scripts": {
    "start": "serve . -l 4173",
    "test": "playwright test -c tests/playwright.config.ts",
    "test:smoke": "playwright test -c tests/playwright.config.ts --grep @smoke",
    "test:ui": "playwright test -c tests/playwright.config.ts --ui",
    "perf:server": "node perf/server/server.js",
    "perf:smoke": "node perf/run.js perf/k6/smoke.ts",
    "typecheck": "tsc -p tests/tsconfig.json && tsc -p perf/tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/k6": "^2.3.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.12.0",
    "serve": "^14.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
